{
  "name": "gh-gitea-proxy",
  "version": "0.1.0",
  "description": "Serve the slice of GitHub's REST and GraphQL API that the gh CLI needs, backed by a Gitea instance",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "gh-gitea-proxy": "bin/gh-gitea-proxy"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/unit/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
